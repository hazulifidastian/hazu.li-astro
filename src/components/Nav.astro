---
import { getAlternateLocalePath } from "@lib/routeMaps";

const lang = Astro.currentLocale;
const isEnglish = lang === "en";
const projectsHref = isEnglish ? "/en/projects" : "/proyek";
const projectsLabel = isEnglish ? "Projects" : "Proyek";
const homeHref = isEnglish ? "/en" : "/";
const homeLabel = isEnglish ? "Home" : "Beranda";
const contactHref = isEnglish ? "/en/contact" : "/kontak";
const contactLabel = isEnglish ? "Contact" : "Kontak";

const currentPath = Astro.url.pathname;
const idHref = getAlternateLocalePath(currentPath, "id");
const enHref = getAlternateLocalePath(currentPath, "en");
const activePath = currentPath.replace(/\/$/, "") || "/";
---

<nav class="site-nav" aria-label={isEnglish ? "Primary" : "Primer"}>
  <div class="site-nav-main">
    <a href={homeHref} aria-current={activePath === homeHref ? "page" : undefined}>{homeLabel}</a>
    <a href={projectsHref} aria-current={activePath === projectsHref ? "page" : undefined}>{projectsLabel}</a>
    <a href={contactHref} aria-current={activePath === contactHref ? "page" : undefined}>{contactLabel}</a>
  </div>
  <div class="site-nav-locale">
    <a href={idHref} lang="id" hreflang="id" aria-current={!isEnglish ? "true" : undefined}>ID</a>
    <span aria-hidden="true">|</span>
    <a href={enHref} lang="en" hreflang="en" aria-current={isEnglish ? "true" : undefined}>EN</a>
  </div>
</nav>
