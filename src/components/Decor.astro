---
interface Props {
  position: string;
}

const { position } = Astro.props;
---

<style>
  .decor div {
    flex: 1;
    height: 0.75rem;
  }

  .site-header.decor {
    display: flex;
    margin-bottom: 2rem;
  }

  .site-header.decor div:nth-child(2) {
    background-color: #111827;
  }

  .site-header.decor div:nth-child(1) {
    background-color: #f76f53;
  }

  .site-footer.decor {
    display: flex;
    margin-top: 3rem;
  }

  .site-footer.decor div:nth-child(2) {
    background-color: #111827;
  }

  .site-footer.decor div:nth-child(3) {
    background-color: #f76f53;
  }
</style>

<div class:list={[position, "decor"]}>
  <div></div>
  <div></div>
  <div></div>
</div>
