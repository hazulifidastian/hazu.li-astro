<a href="#" data-mail-link>email</a>

<script>
  const anchor = document.currentScript?.previousElementSibling;

  if (anchor instanceof HTMLAnchorElement) {
    const parts = [
      [109, 97, 105, 108],
      [104, 97, 122, 117, 46, 108, 105],
    ];
    const decode = (codes) => String.fromCharCode(...codes);
    const href = `mailto:${decode(parts[0])}@${decode(parts[1])}`;

    const activate = () => {
      anchor.href = href;
    };

    anchor.addEventListener(
      "click",
      (event) => {
        event.preventDefault();
        window.location.href = href;
      },
      { passive: false },
    );
    anchor.addEventListener("focus", activate, { once: true });
    anchor.addEventListener("mouseenter", activate, { once: true });
  }
</script>
