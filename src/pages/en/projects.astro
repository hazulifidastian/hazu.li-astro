---
import { Image } from "astro:assets";
import learningCardsImage from "../../assets/projects/learning-cards.png";
import upmonImage from "../../assets/projects/upmon.png";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout>
  <section>
    <h1>Projects</h1>
    <p>
      A few public applications I have built as personal projects.
    </p>

    <ul>
      <li>
        <a target="_blank" href="https://learningcards.hazu.li"
          >Learning Cards &#8599;</a
        >
        <Image
          class="project-image"
          src={learningCardsImage}
          alt="Learning Cards home page"
          width={960}
        />
        <p>
          A digital flashcard application that uses spaced repetition.
        </p>
        <p>
          I designed it to help school and university students memorize learning
          material more effectively and in a more structured way.
        </p>
      </li>
      <li>
        <a target="_blank" href="https://upmon.hazu.li">Upmon &#8599;</a>
        <Image
          class="project-image"
          src={upmonImage}
          alt="Upmon home page"
          width={960}
        />
        <p>
          A multi-region monitoring application for tracking HTTP endpoint
          uptime, port connectivity, SSL certificate validity, and various other
          aspects of service availability.
        </p>
        <p>
          I built it as an Elixir and Phoenix showcase using WebSocket for
          real-time communication. It includes a scheduler, checkers running in
          multiple regions, and a coordination center that receives results
          directly. This keeps monitoring distributed, responsive, and easy to
          observe.
        </p>
      </li>
    </ul>
  </section>
</PageLayout>
