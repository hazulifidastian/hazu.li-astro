---
import PageLayout from "@layouts/PageLayout.astro";
import Mail from "@components/Mail.astro";
---

<PageLayout>
  <section>
    <h2>Kontak</h2>

    <p>
      Tertarik untuk bekerja sama, berdiskusi, atau memiliki pertanyaan seputar
      proyek saya, jangan ragu untuk menghubungi saya melalui email. Saya akan
      berusaha membalas pesan Anda secepat mungkin.
    </p>

    <p>Kirim <Mail /> kepada saya.</p>
  </section>
</PageLayout>
