---
import "@styles/global.css";
import Nav from "@components/Nav.astro";
import SiteTitle from "@components/SiteTitle.astro";

const lang = Astro.currentLocale;
const isEnglish = lang === "en";
const description = isEnglish
  ? "Personal site of Hazuli Fidastian"
  : "Situs personal Hazuli Fidastian";
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>Hazuli Fidastian</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container-sm site-header-inner">
        <SiteTitle />
        <Nav />
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container-sm">
        <section>
          <p class="copyright">&copy; 2026 Hazuli Fidastian</p>
        </section>
      </div>
    </footer>
  </body>
</html>
