---
import Layout from "@layouts/Layout.astro";
const path = Astro.url.pathname.replace(/\/$/, "");
const isHome = path === "" || path === "/en";
---

<Layout>
  <main class:list={["site-main", "page-content", { "home-content": isHome }]}>
    <div class="container-sm">
      <slot />
    </div>
  </main>
</Layout>
